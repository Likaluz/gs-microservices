{
  "name": "solar-shield",
  "version": "1.0.0",
  "description": "Sistema de monitoramento de clima espacial com NASA DONKI, RabbitMQ, Redis e Nginx.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:ingest": "node dist/ingest-service/server.js",
    "start:alert": "node dist/alert-service/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "nasa",
    "donki",
    "rabbitmq",
    "redis",
    "microservices"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "amqplib": "^0.10.5",
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
